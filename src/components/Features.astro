---
import { Shield, Zap, Headphones, Globe } from '@lucide/astro';

const features = [
  { Icon: Shield, title: 'SLA garantizado', desc: 'Acuerdos de nivel de servicio con compensación automática si no cumplimos.' },
  { Icon: Zap, title: 'Baja latencia', desc: 'Routing optimizado y peering directo para latencias por debajo de los 5ms.' },
  { Icon: Headphones, title: 'Soporte 24/7', desc: 'Equipo técnico disponible siempre, con tiempos de respuesta de 15 minutos.' },
  { Icon: Globe, title: 'Cobertura nacional', desc: 'Red propia presente en las principales ciudades del país.' },
];
---
<section class="features-section" id="empresas">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">POR QUÉ ELEGIRNOS</p>
      <h2 class="section-title">Infraestructura que no te frena</h2>
    </div>

    <div class="grid">
      {features.map(({ Icon, title, desc }) => (
        <div class="feature">
          <div class="icon-wrap">
            <Icon size={24} strokeWidth={2} />
          </div>
          <h3>{title}</h3>
          <p>{desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features-section {
    padding: 96px 0;
    background: transparent;
  }

  .section-head {
    text-align: center;
    margin-bottom: 56px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: center;
  }

  .eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--color-primary);
    text-transform: uppercase;
  }

  .section-title {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }

  .feature {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 30px 28px;
    border-radius: var(--glass-radius);
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .feature:hover {
    transform: translateY(-6px);
    box-shadow: var(--glass-shadow-hover);
  }

  .icon-wrap {
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: linear-gradient(150deg, rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0.32));
    border: 1px solid rgba(255, 255, 255, 0.7);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
    box-shadow:
      0 6px 14px -6px rgba(38, 56, 105, 0.30),
      inset 0 1px 1px rgba(255, 255, 255, 0.9);
  }
  .feature:nth-child(even) .icon-wrap { color: var(--color-secondary); }

  .feature h3 {
    font-size: 17px;
    font-weight: 700;
  }

  .feature p {
    font-size: 14px;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
