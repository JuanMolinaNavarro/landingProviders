---
const groups = [
    {
        title: "Servicios",
        links: [
            "Fibra empresarial",
            "Enlaces dedicados",
            "IP fija",
            "Cloud hosting",
        ],
    },
    {
        title: "Empresa",
        links: [
            "Sobre nosotros",
            "Cobertura",
            "Casos de éxito",
            "Trabajá con nosotros",
        ],
    },
    {
        title: "Soporte",
        links: [
            "Centro de ayuda",
            "Estado de red",
            "Contacto",
            "SLA y términos",
        ],
    },
];
---

<footer class="footer">
    <div class="container">
        <div class="grid">
            <div class="brand">
                <a href="#" class="logo">
                    <span class="logo-text">Providers</span>
                    <span class="logo-dot"></span>
                </a>
                <p class="tagline">
                    Conectividad empresarial confiable. Fibra simétrica con SLA
                    garantizado.
                </p>
                <div class="social">
                    <a href="#" aria-label="LinkedIn">
                        <svg
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            aria-hidden="true"
                        >
                            <path
                                d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"
                            ></path>
                        </svg>
                    </a>
                    <a href="#" aria-label="X / Twitter">
                        <svg
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            aria-hidden="true"
                        >
                            <path
                                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"
                            ></path>
                        </svg>
                    </a>
                </div>
            </div>

            <div class="link-cols">
                {
                    groups.map((g) => (
                        <div class="col">
                            <h4>{g.title}</h4>
                            <ul>
                                {g.links.map((l) => (
                                    <li>
                                        <a href="#">{l}</a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </div>

        <div class="copyright">
            © {new Date().getFullYear()} Providers. Todos los derechos reservados.
        </div>
    </div>
    <div class="footer-cluster" aria-hidden="true">
        <img src="/icons3d/footerImage.png" alt="" decoding="async" />
    </div>
</footer>

<style>
    .footer {
        background: transparent;
        padding: 72px 0 0;
    }

    /* banda decorativa de iconos clay al final de la página */
    .footer-cluster {
        width: min(860px, 92%);
        aspect-ratio: 2.9 / 1;
        margin: 8px auto 0;
        overflow: hidden;
        pointer-events: none;
    }
    .footer-cluster img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center bottom;
    }

    .grid {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 48px;
    }

    .brand {
        display: flex;
        flex-direction: column;
        gap: 16px;
        max-width: 320px;
    }

    .logo {
        display: inline-flex;
        align-items: baseline;
        gap: 4px;
        font-weight: 800;
        font-size: 20px;
        letter-spacing: -0.02em;
        color: var(--color-text);
    }

    .logo-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--color-primary);
        display: inline-block;
        box-shadow: var(--shadow-primary-sm);
    }

    .tagline {
        color: var(--color-text-muted);
        font-size: 14px;
        line-height: 1.55;
    }

    .social {
        display: flex;
        gap: 10px;
        margin-top: 4px;
    }
    .social a {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: var(--neu-bg);
        box-shadow: var(--btn-rest);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-primary);
        transition:
            box-shadow var(--btn-ease),
            color var(--btn-ease);
    }
    .social a:hover,
    .social a:active {
        box-shadow: var(--btn-press);
        color: var(--color-primary-dark);
    }

    .link-cols {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 32px;
    }

    .col h4 {
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-text);
        margin-bottom: 14px;
    }

    .col ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .col a {
        font-size: 14px;
        color: var(--color-text-muted);
        transition: color 0.15s ease;
    }
    .col a:hover {
        color: var(--color-primary);
    }

    .copyright {
        margin-top: 56px;
        padding-top: 26px;
        border-top: 1px solid var(--neu-dark);
        box-shadow: inset 0 1px 0 var(--neu-light);
        text-align: center;
        font-size: 13px;
        color: var(--color-text-muted);
    }

    @media (max-width: 800px) {
        .grid {
            grid-template-columns: 1fr;
            gap: 40px;
        }
        .link-cols {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @media (max-width: 500px) {
        .link-cols {
            grid-template-columns: 1fr;
        }
    }
</style>
