---
const stats = [
  { num: '99.9%', label: 'Uptime garantizado', color: 'blue' },
  { num: '< 5ms', label: 'Latencia promedio', color: 'violet' },
  { num: '15min', label: 'Respuesta de soporte', color: 'blue' },
  { num: '+2.500', label: 'Empresas conectadas', color: 'violet' },
];
---
<section class="stats-section" id="soporte">
  <div class="container">
    <div class="grid">
      {stats.map((s) => (
        <div class="cell">
          <div class={`num ${s.color}`}>{s.num}</div>
          <div class="label">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stats-section {
    padding: 84px 0;
    background: transparent;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
    border-radius: var(--glass-radius);
    box-shadow: var(--glass-shadow);
    padding: 20px 12px;
  }

  .cell {
    text-align: center;
    padding: 24px 20px;
    position: relative;
  }
  .cell + .cell::before {
    content: '';
    position: absolute;
    left: 0;
    top: 20%;
    bottom: 20%;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(180deg, transparent, var(--neu-dark), transparent);
    box-shadow: 1px 0 0 rgba(255, 255, 255, 0.7);
  }

  .num {
    font-size: clamp(36px, 4vw, 48px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .num.blue   { color: var(--color-primary); }
  .num.violet { color: var(--color-secondary); }

  .label {
    margin-top: 12px;
    font-size: 13px;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, 1fr); row-gap: 8px; }
    /* en 2 columnas, ocultar el divisor de la 3.ª celda (inicio de fila) */
    .cell:nth-child(3)::before { display: none; }
  }
  @media (max-width: 480px) {
    .grid { grid-template-columns: 1fr; }
    .cell + .cell::before { display: none; }
  }
</style>
